# FieldShift AI - Root Environment Configuration Template
# Copy this file to backend/.env or use standard Docker Compose defaults.

APP_NAME="FieldShift AI"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS configuration for Frontend Web App
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Target Agro-ecological Region
DEFAULT_REGION="Kerala, India"

# Optional LLM API Keys (FieldShift AI assistant runs local agronomic expert rules if left empty)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
