# Copy to .env next to docker-compose.yml. Never commit the real .env.

# --- Stack ---
IMAGE_TAG=latest
PROXY_PORT=8080
# 127.0.0.1 = reachable only via Tailscale Funnel/localhost. Use 0.0.0.0 to allow your LAN too.
PROXY_BIND=127.0.0.1
WATCHTOWER_POLL_INTERVAL=300
TZ=Asia/Kolkata

# --- Backend (passed into the backend container) ---
SECRET_KEY=change-me-to-a-long-random-string
DEFAULT_REGION=Kerala, India
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25
